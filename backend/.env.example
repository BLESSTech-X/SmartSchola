# Copy to .env for local development. Never commit real .env files.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./smartschola-dev.db
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Only needed when running create_admin.py
ADMIN_EMAIL=admin@example.test
ADMIN_FULL_NAME=Local Test Administrator
ADMIN_INITIAL_PASSWORD=replace-with-a-long-unique-password

# Required for support-verified account recovery email delivery
FRONTEND_BASE_URL=https://your-frontend.example/SmartSchola
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=SmartSchola Support <support@example.com>
